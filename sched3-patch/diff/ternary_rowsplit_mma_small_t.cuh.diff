+[[nodiscard]] inline bool ternary_mma_ksplit_enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("NINFER_TERNARY_KSPLIT");
+        return value != nullptr && std::string(value) == "1";
+    }();
+    return enabled;
